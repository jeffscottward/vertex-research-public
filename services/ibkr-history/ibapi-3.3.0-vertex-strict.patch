+#[tokio::test]
+async fn vertex_strict_bars_complete_only_after_payload_and_terminal() {
+    let (message_bus, mut subscription) = vertex_bar_fixture(vec![vertex_bar_payload(), vertex_bar_terminal()]).await;
+    assert_eq!(subscription.request_id(), TEST_REQ_ID_FIRST);
+    assert!(!subscription.source_response_complete());
+
+    let HistoricalBarUpdate::Historical(data) = expect_data(vertex_bar_next(&mut subscription).await) else {
+        panic!("expected the historical payload");
+    };
+    assert_eq!(data.bars.len(), 2);
+    assert_eq!(data.bars[0].date, BarTimestamp::DateTime(datetime!(2023-03-15 13:20:00 UTC)));
+    assert_eq!(data.bars[1].date, BarTimestamp::Date(date!(2023-03-15)));
+    assert_eq!(data.bars[0].open.to_bits(), (-0.0_f64).to_bits());
+    assert!(!subscription.source_response_complete(), "payload alone is not completion");
+
+    assert!(matches!(expect_data(vertex_bar_next(&mut subscription).await), HistoricalBarUpdate::End { .. }));
+    assert!(subscription.source_response_complete());
+    assert!(vertex_bar_next(&mut subscription).await.is_none());
+    assert!(subscription.source_response_complete());
+    assert_eq!(request_message_count(&message_bus), 1, "strict acquisition must not retry");
