+// Vertex opt-in extension. Existing fetch/stream and tick defaults are unchanged.
+// This consumes only the SDK's existing request-scoped routed envelopes/codecs.
+#[allow(clippy::too_many_arguments)]
+pub(crate) async fn historical_data_strict(
+    client: &Client,
+    contract: &Contract,
+    end_date: Option<OffsetDateTime>,
+    duration: Duration,
+    bar_size: BarSize,
+    what_to_show: WhatToShow,
+    trading_hours: TradingHours,
+) -> Result<StrictHistoricalDataSubscription, Error> {
+    common::validate_historical_data(client.server_version(), contract, end_date, Some(what_to_show))?;
+    let builder = client.request();
+    let request_id = builder.request_id();
+    let request = encoders::encode_request_historical_data(
+        request_id, contract, end_date, duration, bar_size, Some(what_to_show),
+        trading_hours.use_rth(), false, &Vec::<crate::contracts::TagValue>::default(),
+    )?;
+    let messages = builder.send_raw(request).await?;
+    Ok(StrictHistoricalDataSubscription {
+        messages, request_id, message_bus: Arc::clone(&client.message_bus),
+        data_seen: false, end_seen: false, failed: false, cancelled: AtomicBool::new(false),
+    })
+}
+
+/// One request, no retry, keepUpToDate=false. Completion requires a decoded
+/// HistoricalData payload followed by the separate HistoricalDataEnd payload.
+/// Completion certifies that response only, not market coverage or raw fidelity.
+#[must_use = "poll this subscription to observe data and the genuine terminal event"]
+pub struct StrictHistoricalDataSubscription {
+    messages: AsyncInternalSubscription,
+    request_id: i32,
+    message_bus: Arc<dyn AsyncMessageBus>,
+    data_seen: bool,
+    end_seen: bool,
+    failed: bool,
+    cancelled: AtomicBool,
+}
+
+impl StrictHistoricalDataSubscription {
+    pub fn request_id(&self) -> i32 { self.request_id }
+
+    pub fn source_response_complete(&self) -> bool {
+        self.data_seen && self.end_seen && !self.failed && !self.cancelled.load(Ordering::Relaxed)
+    }
+
+    /// Successful return is a local send receipt, NOT a broker acknowledgment.
+    /// Cancellation of this future after dispatch leaves its send outcome unknown.
+    pub async fn cancel_checked(&self) -> Result<(), Error> {
+        if self.source_response_complete() { return Ok(()); }
+        if self.cancelled.swap(true, Ordering::Relaxed) {
+            return Err(Error::Simple("historical cancellation already attempted".into()));
+        }
+        let message = encoders::encode_cancel_historical_data(self.request_id)?;
+        self.message_bus.cancel_subscription(self.request_id, message).await
+    }
+}
+
+impl Stream for StrictHistoricalDataSubscription {
+    type Item = Result<SubscriptionItem<HistoricalBarUpdate>, Error>;
+
+    fn poll_next(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+        use crate::subscriptions::common::RoutedItem;
+        let this = self.get_mut();
+        if this.failed || this.end_seen || this.cancelled.load(Ordering::Relaxed) {
+            return Poll::Ready(None);
+        }
+        let routed = match Pin::new(&mut this.messages.stream).poll_next(cx) {
+            Poll::Ready(Some(Ok(item))) => item,
+            Poll::Ready(Some(Err(lag))) => {
+                this.failed = true;
+                return Poll::Ready(Some(Err(Error::Simple(format!("strict historical channel lag: {lag}")))));
+            }
+            Poll::Ready(None) => {
+                this.failed = true;
+                return Poll::Ready(Some(Err(Error::UnexpectedEndOfStream)));
+            }
+            Poll::Pending => return Poll::Pending,
+        };
+        let result = match routed {
+            RoutedItem::Notice(notice) => return Poll::Ready(Some(Ok(SubscriptionItem::Notice(notice)))),
+            RoutedItem::Error(error) => Err(error),
+            RoutedItem::Response(message) => match message.message_type() {
+                IncomingMessages::HistoricalData if !this.data_seen => {
+                    decoders::decode_historical_data(&message).map(|data| {
+                        this.data_seen = true;
+                        HistoricalBarUpdate::Historical(data)
+                    })
+                }
+                IncomingMessages::HistoricalDataEnd if this.data_seen => {
+                    decoders::decode_historical_data_end(&message).map(|(start, end)| {
+                        this.end_seen = true;
+                        HistoricalBarUpdate::End { start, end }
+                    })
+                }
+                IncomingMessages::Error => Err(Error::from(message)),
+                _ => Err(Error::unexpected_response(&message)),
+            },
+        };
+        if result.is_err() { this.failed = true; }
+        Poll::Ready(Some(result.map(SubscriptionItem::Data)))
+    }
+}
+
+impl Drop for StrictHistoricalDataSubscription {
+    fn drop(&mut self) {
+        if self.end_seen || self.cancelled.swap(true, Ordering::Relaxed) { return; }
+        let request_id = self.request_id;
+        let message_bus = Arc::clone(&self.message_bus);
+        if let Ok(message) = encoders::encode_cancel_historical_data(request_id) {
+            tokio::spawn(async move {
+                if let Err(error) = message_bus.cancel_subscription(request_id, message).await {
+                    warn!("error cancelling strict historical data on drop: {error}");
+                }
+            });
+        }
+    }
+}
