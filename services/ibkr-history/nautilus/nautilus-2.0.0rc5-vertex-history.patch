+// 0: never used, 1: ordinary registry, 2: exclusive history generation.
+// This latch is process-wide and never clears, including failed bootstrap.
+#[cfg(feature = "vertex-history")]
+static VERTEX_USE: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
