#   uv pip compile --generate-hashes --only-binary :all: --python-version 3.12 \
#     --python-platform x86_64-manylinux_2_28 --exclude-newer 2026-11-08T00:00:00Z \
#     requirements-openbb.in -o requirements-openbb-linux-py312.lock
