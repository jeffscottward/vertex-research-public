{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vertex rebuild deliverables ledger",
  "type": "object",
  "required": [
    "schemaVersion",
    "asOf",
    "state",
    "modules",
    "workPackages",
    "deliverables",
    "coverageIndex"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "asOf": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "modules": {
      "type": "object"
    },
    "workPackages": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "sourceReferences",
          "sourceValue",
          "effectiveRequirement",
          "module",
          "owner",
          "targetModules",
          "gates",
          "state",
          "acceptance",
          "implementationEvidence",
          "userRequirementIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": ["planned", "blocked", "not_adopted", "superseded"]
          },
          "targetModules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "sourceReferences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["file", "pointer", "sha256"]
            }
          },
          "acceptance": {
            "type": "object",
            "required": ["predicate", "receipt"]
          },
          "implementationEvidence": {
            "type": "null"
          }
        }
      }
    },
    "coverageIndex": {
      "type": "array"
    }
  }
}
