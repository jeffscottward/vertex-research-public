# DarkFactory environment template. `bun run setup` copies it to the ignored
# `.env` (mode 0600), generates the empty local secrets, and sets the local
# DATABASE_URL; it never overwrites a value you already set.
# The single validated contract is the Zod schema in
# packages/config/src/server.ts (parseServerEnv). Empty optional values keep
# their capabilities disabled. Keep real secrets out of Git; 1Password users can
# wrap commands with `op run --env-file=.env --`.

# --- Application
# development | test | production
APP_ENV=development
# Clean HTTPS origin without a trailing slash; must equal BETTER_AUTH_URL.
APP_URL=https://darkfactory.localhost
APP_NAME=Vertex Research

# --- Database
# postgres (default) | planetscale | hyperdrive
# Production: postgres needs sslmode=verify-full and a non-local host;
# planetscale needs the *.pg.psdb.cloud PgBouncer URL on port 6432 with
# sslmode=verify-full; hyperdrive takes the connection from the Worker's
# HYPERDRIVE binding and rejects DATABASE_URL (docs/deploy.md#hyperdrive).
DATABASE_PROVIDER=postgres
# Vertex production: privately routed PostgreSQL on dev-rig; do not expose
# its port publicly. Supply the exact comma-separated DNS host allowlist; empty
# denies production access. DATABASE_URL must use an allowed DNS host, explicit
# port 5432 or 6432, and sslmode=verify-full. Cloudflare Workers also require
# configured private connectivity/Hyperdrive; this file does not provision it.
DATABASE_ALLOWED_HOSTS=
# Required for local runs. Secret. Setup fills the local compose app role:
# postgresql://darkfactory_app:darkfactory-app-local-only@127.0.0.1:55582/darkfactory_dev
DATABASE_URL=
# The test suites (`bun run test`, test:integration, the browser lane) ignore
# DATABASE_URL: they run with APP_ENV=test against this local maintenance
# database. Empty means the compose test role (bun run db:test:up):
# postgresql://darkfactory_test_runner:darkfactory-test-only@127.0.0.1:55582/darkfactory_test_maintenance
TEST_DATABASE_URL=

# --- Authentication
# Secret, at least 32 characters. Setup generates a local value when empty.
BETTER_AUTH_SECRET=
# Independent secret (at least 32 characters) for HMAC contact abuse buckets.
# Do not reuse the authentication secret. Setup generates a local value.
CONTACT_THROTTLE_SECRET=
BETTER_AUTH_URL=https://darkfactory.localhost

# --- Operator workflow pilot
# Exact owner-to-repository grants: ownerId=repositoryId pairs separated by
# commas. Required by the operator API and worker; no wildcards. Secret.
WORKFLOW_REPOSITORY_GRANTS=
# Approved Docker verification contract; free-form commands are not accepted.
WORKFLOW_VERIFIER_ID=darkfactory-verify-core-v2
# 71-character content digest printed by
# `pnpm --filter @darkfactory/jobs verifier:image:setup`; production workers
# require it.
WORKFLOW_VERIFIER_IMAGE_DIGEST=
# Rootless Docker (or any local daemon) for the verifier: set its unix socket,
# for example DOCKER_HOST=unix:///run/user/1000/docker.sock. Only local unix
# sockets are accepted.
# Worker-only tuning. WORKFLOW_REPOSITORIES_ROOT must be an absolute path.
WORKFLOW_REPOSITORIES_ROOT=
WORKFLOW_LEASE_OWNER=
WORKFLOW_POLL_INTERVAL_MS=
WORKFLOW_SHUTDOWN_TIMEOUT_MS=
# Linux: OMP runs have no network and reach their model through a local
# `omp auth-gateway` (docs/operator.md#models-and-credentials). The token file
# must belong to the worker's user and be readable by no one else (0600).
WORKFLOW_OMP_GATEWAY_URL=
WORKFLOW_OMP_GATEWAY_TOKEN_FILE=
# The model every Linux OMP step uses (planning, implementation, review): your
# own choice, as provider/model from the gateway's model list. No default;
# required with WORKFLOW_OMP_GATEWAY_URL.
WORKFLOW_OMP_MODEL=

# --- AI provider (disabled until both values are configured)
AI_PROVIDER=groq
# Secret.
GROQ_API_KEY=
GROQ_MODEL=

# --- Email provider (preview is the safe local transport)
# resend | disabled
EMAIL_PROVIDER=resend
# preview | resend | disabled
EMAIL_TRANSPORT=preview
# Secret.
RESEND_API_KEY=
EMAIL_FROM=Vertex Research <noreply@domain.test>
# Optional recipient for public contact submissions. Empty disables delivery.
CONTACT_EMAIL_TO=

# --- Analytics provider (disabled until key and host are configured)
ANALYTICS_PROVIDER=posthog
# Secret.
POSTHOG_KEY=
POSTHOG_HOST=

# --- Telemetry (instrumentation is core; remote export is optional)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=darkfactory-web
# Secret (may embed credentials).
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Optional storage capability (packages/storage); disabled until configured.
STORAGE_ENABLED=false

# --- Vertex research baseline: all new names are server-only.
# Empty values are placeholders, not working credentials or runtime availability.
# Provision rig PostgreSQL and secure routing; use canonical DATABASE_URL above, not a duplicate SQL secret.
# No environment value authorizes trading. Native adapters must validate first.
VERTEX_MODE=research
VERTEX_ACCESS_MODE=read-only
VERTEX_ORDER_SUBMISSION=disabled

# Market data: no fabricated or silently substituted production data.
MARKET_DATA_RUNTIME_STATE=disabled
QUANTDATA_API_BASE_URL=
QUANTDATA_API_KEY=
FINANCIAL_DATASETS_API_BASE_URL=
FINANCIAL_DATASETS_API_KEY=

# Quant VPS owns execution/risk. IBKR credentials/MFA are human-managed.
QUANT_RUNTIME_STATE=disabled
QUANT_VPS_API_URL=
QUANT_VPS_API_TOKEN=
# Tailnet-only read-only session snapshot (vertex-deploy-status-v2); uses VERTEX_DEPLOY_STATUS_TOKEN.
VERTEX_DEPLOY_STATUS_V2_URL=
# Read-only IBKR history service base URL (marketData.bars); uses VERTEX_DEPLOY_STATUS_TOKEN.
# Tailnet https, or loopback http when the web app runs on the same host (QuantVPS: http://127.0.0.1:8791/vertex-history/v1).
VERTEX_HISTORY_URL=
# Tailnet-only read-only research lens documents base URL (researchLenses.*); uses VERTEX_DEPLOY_STATUS_TOKEN.
VERTEX_RESEARCH_LENSES_URL=
# Read-only IBKR portfolio service base URL (portfolioMonitor.snapshot); uses VERTEX_DEPLOY_STATUS_TOKEN.
# Tailnet https, or loopback http when the web app runs on the same host (QuantVPS: http://127.0.0.1:8792/vertex-portfolio/v1).
VERTEX_PORTFOLIO_URL=
# Tailnet-only human IBKR 2FA recovery service base URL (ibkrRecovery.*), e.g.
# https://<vps>.ts.net:8443/vertex-ibkr-recovery/v1. Uses its own token below, never VERTEX_DEPLOY_STATUS_TOKEN.
VERTEX_IBKR_RECOVERY_URL=
VERTEX_IBKR_RECOVERY_TOKEN=
# Price alert ntfy delivery (priceAlerts.*): bare https origin (e.g. https://ntfy.sh), topic, optional token.
# Unset => triggered rules show in the portal only (delivery "not configured"). Never log the topic or token.
VERTEX_PRICE_ALERTS_NTFY_ORIGIN=
VERTEX_PRICE_ALERTS_NTFY_TOPIC=
VERTEX_PRICE_ALERTS_NTFY_TOKEN=
# Optional absolute base URL for Academy media hosted outside the web app, e.g. the rig's tailnet-only reports URL.
VERTEX_ACADEMY_MEDIA_BASE_URL=
# Optional tailnet-only kb-chat front end URL framed by the Knowledge page; unset shows a fallback note.
VERTEX_KB_CHAT_URL=
# Loopback-only ibkr-monitor base URL (ibkrMonitor.snapshot, Portfolio tab), e.g. http://127.0.0.1:3461.
IBKR_MONITOR_URL=
# Loopback-only rig status file server (engines.status and marketContext.get: Engines and Market context views),
# e.g. http://127.0.0.1:3462.
ENGINE_STATUS_URL=
# Read-only agent viewers (comma list): see operator pages; every write is refused (403).
# Must not overlap VERTEX_OPERATOR_EMAILS.
VERTEX_AGENT_VIEWER_EMAILS=
# Owner order screen (Portfolio > Orders). Keep false: while false only the mock gateway is used
# and nothing reaches IBKR. Turning it on in production is the owner's decision.
VERTEX_ORDERS_ENABLED=false
# Loopback order bridge for the IBKR gateway, e.g. http://127.0.0.1:3470 (used only when enabled).
VERTEX_ORDER_BRIDGE_URL=
# Shared secret the order bridge requires (header X-Vertex-Bridge-Token). Server-only.
VERTEX_ORDER_BRIDGE_TOKEN=
# Operator research assistant (/assistant): OpenRouter key, server-only; never sent to the browser or logged.
OPENROUTER_API_KEY=
# OpenRouter tool-capable model id for the assistant.
VERTEX_ASSISTANT_MODEL=anthropic/claude-sonnet-4.5
# Engine of new backtest runs: typescript (default, runs in the API server) or nautilus (queued for
# the Nautilus research worker on the rig, see infra/research-worker/README.md).
VERTEX_BACKTEST_RUNS_ENGINE=typescript
NAUTILUS_RUNTIME_STATE=disabled
NAUTILUS_TRADING_MODE=paper
IBKR_RUNTIME_STATE=disabled
IBKR_TRADING_MODE=paper
IBKR_READ_ONLY=true
IBKR_RECOVERY_POLICY=human-trigger-only
IBKR_HOST=
IBKR_PORT=
IBKR_CLIENT_ID=
IBKR_ACCOUNT_ID=

# The Python research service (Agno model bridge) and the Rust services run outside Cloudflare Workers.
RESEARCH_RUNTIME_STATE=disabled
GAMMA_RESEARCH_API_URL=
GAMMA_RESEARCH_API_TOKEN=
AGNO_RUNTIME_STATE=disabled
AGNO_API_URL=
AGNO_API_TOKEN=
RUST_KERNEL_RUNTIME_STATE=disabled
RUST_KERNEL_API_URL=
RUST_KERNEL_API_TOKEN=

# Optional Alpha renderer: unavailable until exact-pinned and integrated.
CHART_RUNTIME_STATE=disabled
CHART_RENDERER=tanstack-charts-alpha

# Notification/email delivery disabled; email uses EMAIL_*/RESEND_API_KEY above.
NOTIFICATION_RUNTIME_STATE=disabled
NOTIFICATION_PROVIDER=disabled
NTFY_SERVER_URL=
NTFY_TOPIC=
NTFY_ACCESS_TOKEN=
NOTIFICATION_EMAIL_TO=
# Contact address in the SEC/House Clerk fetch User-Agent (server-side only; placeholder when empty).
VERTEX_RESEARCH_CONTACT_EMAIL=

# Optional JEV: no financial-services pages, personal data, secrets, or trade authority.
# Empty allowed origins deny all observations; existing watcher identity is unverified.
JEV_RUNTIME_STATE=disabled
JEV_API_URL=
JEV_API_TOKEN=
JEV_ALLOWED_ORIGINS=

# Absolute local-only paths after provenance/licensing review; never commit raw data.
RESEARCH_CORPUS_ROOT=
DELTATREND_CORPUS_PATH=
VERRILLO_CORPUS_PATH=
CROWN_CORPUS_PATH=
DEFINE_YOUR_RISK_CORPUS_PATH=
SSRN_CORPUS_PATH=
