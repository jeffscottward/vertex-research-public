#!/usr/bin/env bash
# Merge one pull request into its protected base branch, one merge at a time.
#
# Why: the base branch requires a strict, up-to-date ci-gate (about 40 min of CI).
# When two jobs merge on their own, the slower one loses the race, must update and
# rerun CI, and can lose again. GitHub's merge queue is not offered for this
# user-owned repository (a merge_queue ruleset is refused with HTTP 422), so this
# script serializes merges through the firstmate claim
# branch:<repo>:<base> (card vertex-base-merge-serialization, 2026-11-12).
#
# Usage: scripts/merge-pr <pr-number> --card <card> [--wait <minutes>] [--ci-timeout <minutes>]
#
# Steps: claim the base branch (refused while another card holds it, exit 4; with
# --wait, retry until it frees up), merge the base into the PR when it is behind
# (gh pr update-branch), wait until every required check passes on the current
# head, merge with a merge commit pinned to that head, check that the merge
# commit's tree equals the PR head's tree, and release the claim on any exit.
# The script never bypasses required checks, never force-pushes and never reruns CI.
# A conflict while updating stops the script: merge the base locally, push, rerun.
#
# Environment: MERGE_PR_POLL_SECONDS (default 60) is the poll interval;
# MERGE_PR_BEAT_SECONDS (default 300) is how often the card gets a heartbeat,
# which keeps the claim alive (a claim expires 30 min after the last beat).
set -euo pipefail

usage() {
  echo "usage: scripts/merge-pr <pr-number> --card <card> [--wait <minutes>] [--ci-timeout <minutes>]" >&2
  exit 2
}

pr=""
card="${FM_CARD:-}"
wait_minutes=0
ci_timeout_minutes=90
while (($# > 0)); do
  case "$1" in
    --card) card="${2:-}"; shift 2 || usage ;;
    --wait) wait_minutes="${2:-}"; shift 2 || usage ;;
    --ci-timeout) ci_timeout_minutes="${2:-}"; shift 2 || usage ;;
    -h | --help) usage ;;
    -*) usage ;;
    *) [[ -z "$pr" ]] || usage; pr="$1"; shift ;;
  esac
done
[[ "$pr" =~ ^[0-9]+$ && -n "$card" ]] || usage
[[ "$wait_minutes" =~ ^[0-9]+$ && "$ci_timeout_minutes" =~ ^[0-9]+$ ]] || usage

poll_seconds="${MERGE_PR_POLL_SECONDS:-60}"
beat_seconds="${MERGE_PR_BEAT_SECONDS:-300}"
max_update_rounds=5

log() { echo "merge-pr #$pr: $*" >&2; }
die() { log "$1"; exit "${2:-1}"; }

last_beat=0
beat() {
  local now
  now=$(date +%s)
  if [[ "${2:-}" == force ]] || ((now - last_beat >= beat_seconds)); then
    fm beat "$card" "merge-pr #$pr: $1" >/dev/null || log "fm beat failed (continuing)"
    last_beat=$now
  fi
}

repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
repo_name=${repo#*/}

IFS=$'\t' read -r state draft base head < <(
  gh pr view "$pr" --json state,isDraft,baseRefName,headRefOid \
    --jq '[.state, .isDraft, .baseRefName, .headRefOid] | @tsv'
)
[[ "$state" == OPEN ]] || die "PR is $state, not OPEN"
[[ "$draft" == false ]] || die "PR is a draft; run gh pr ready $pr first"

resource="branch:$repo_name:$base"
claimed=false
release() {
  if [[ "$claimed" == true ]]; then
    fm release "$card" "$resource" >/dev/null || log "fm release failed; run: fm release $card $resource"
  fi
}
trap release EXIT
trap 'exit 130' INT TERM

# Claim the base branch. Exit code 4 from fm means another live card holds it.
deadline=$(($(date +%s) + wait_minutes * 60))
while true; do
  set +e
  claim_out=$(fm claim "$card" "$resource" 2>&1)
  claim_rc=$?
  set -e
  if ((claim_rc == 0)); then
    claimed=true
    break
  fi
  if ((claim_rc != 4)); then
    echo "$claim_out" >&2
    die "fm claim failed (exit $claim_rc)"
  fi
  if (($(date +%s) >= deadline)); then
    echo "$claim_out" >&2
    die "another card holds $resource; retry later or pass --wait <minutes>" 4
  fi
  log "waiting for $resource: $claim_out"
  sleep "$poll_seconds"
done
log "claimed $resource for card $card"
beat "claimed $base, checking PR head" force

ref_sha() { gh api "repos/$repo/git/ref/heads/$1" --jq .object.sha; }
pr_head() { gh pr view "$pr" --json headRefOid --jq .headRefOid; }

# Prints pass, fail or pending for the required checks on the PR's current head.
# "No required checks reported" (gh exits 1) means the run has not registered yet.
checks_state() {
  local buckets
  buckets=$(gh pr checks "$pr" --required --json bucket --jq '.[].bucket' 2>/dev/null) || buckets=""
  if [[ -z "$buckets" ]]; then
    echo pending
  elif grep -q -x -E 'fail|cancel' <<<"$buckets"; then
    echo fail
  elif grep -q -v -x pass <<<"$buckets"; then
    echo pending
  else
    echo pass
  fi
}

rounds=0
while true; do
  rounds=$((rounds + 1))
  ((rounds <= max_update_rounds)) || die "base moved $max_update_rounds times while this script held the claim; check who merges without scripts/merge-pr"
  head=$(pr_head)
  base_sha=$(ref_sha "$base")
  behind=$(gh api "repos/$repo/compare/$base_sha...$head" --jq .behind_by)
  if ((behind > 0)); then
    log "head $head is $behind commit(s) behind $base; merging $base into the PR"
    beat "updating branch ($behind behind $base)" force
    gh pr update-branch "$pr" >&2 || die "gh pr update-branch failed (conflict?): merge origin/$base into the PR branch locally, push, then rerun scripts/merge-pr"
    new_head=$(pr_head)
    [[ "$new_head" != "$head" ]] || die "update-branch did not move the PR head"
    head=$new_head
  fi

  log "waiting for required checks on $head (at most $ci_timeout_minutes min)"
  beat "waiting for CI on ${head:0:8}" force
  ci_deadline=$(($(date +%s) + ci_timeout_minutes * 60))
  while true; do
    current=$(pr_head)
    [[ "$current" == "$head" ]] || die "PR head moved to $current while waiting for CI; rerun scripts/merge-pr"
    result=$(checks_state)
    case "$result" in
      pass) break ;;
      fail)
        gh pr checks "$pr" --required >&2 || true
        die "required checks failed on $head; fix it, push, then rerun scripts/merge-pr"
        ;;
    esac
    (($(date +%s) < ci_deadline)) || die "required checks still pending on $head after $ci_timeout_minutes min"
    beat "waiting for CI on ${head:0:8}"
    sleep "$poll_seconds"
  done

  # A merge that skipped this script may have moved the base meanwhile.
  base_sha=$(ref_sha "$base")
  behind=$(gh api "repos/$repo/compare/$base_sha...$head" --jq .behind_by)
  if ((behind == 0)); then
    break
  fi
  log "base moved to $base_sha while CI ran; updating again"
done

log "required checks green on $head; merging"
beat "merging ${head:0:8} into $base" force
gh pr merge "$pr" --merge --match-head-commit "$head" >&2

IFS=$'\t' read -r state merge_sha < <(
  gh pr view "$pr" --json state,mergeCommit --jq '[.state, .mergeCommit.oid] | @tsv'
)
[[ "$state" == MERGED ]] || die "PR is $state after gh pr merge"
head_tree=$(gh api "repos/$repo/commits/$head" --jq .commit.tree.sha)
merge_tree=$(gh api "repos/$repo/commits/$merge_sha" --jq .commit.tree.sha)
[[ "$head_tree" == "$merge_tree" ]] || die "merge commit $merge_sha tree $merge_tree differs from PR head $head tree $head_tree" 5
log "merged as $merge_sha (tree $merge_tree equals PR head $head tree)"
echo "$merge_sha"
