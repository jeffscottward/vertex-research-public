{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    "package.json",
    "tsconfig.base.json",
    "tsconfig.json",
    "vitest.config.ts"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "passThroughEnv": ["HOST", "PORT", "NODE_EXTRA_CA_CERTS", "PORTLESS_*"],
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".wrangler/deploy/**"]
    },
    "@darkfactory/web#build": {
      "dependsOn": ["^build"],
      "env": ["VERTEX_BUILD_SHA"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "cache": false,
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "test:unit": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["VERTEX_TEST_PYTHON"]
    },
    "test:integration": {
      "cache": false,
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    }
  }
}
