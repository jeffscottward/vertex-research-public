{
  "name": "@darkfactory/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for the Vertex site: workspace windows, tray watchlist, alerts",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "electron:install": "node ./node_modules/electron/install.js",
    "start": "electron .",
    "test:unit": "pnpm exec vitest run --config ../../vitest.config.ts --project unit .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@darkfactory/api": "workspace:*",
    "@orpc/client": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "45.2.3",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "brick": "app"
}
