{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vertex-research-web",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "workers_dev": false,
  // Server bundles emit maps (apps/web/vite.config.ts#environmentOptimizerPolicy);
  // upload them privately so Workers stack traces are symbolicated. Envs inherit it.
  "upload_source_maps": true,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 500
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  },
  "routes": [],
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://app.vertex.xyz",
    "APP_NAME": "Vertex Research",
    "DATABASE_PROVIDER": "postgres",
    "BETTER_AUTH_URL": "https://app.vertex.xyz",
    "EMAIL_PROVIDER": "disabled",
    "EMAIL_TRANSPORT": "disabled"
  },
  // Optional Cloudflare Hyperdrive (docs/deploy.md#hyperdrive). Bindings are not inherited:
  // each environment declares its own, with the id that `wrangler hyperdrive create`
  // printed for that environment's instance, and sets DATABASE_PROVIDER to "hyperdrive".
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<production-hyperdrive-id>" }],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "env": {
    "staging": {
      "name": "vertex-research-web-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "APP_ENV": "production",
        "APP_URL": "https://staging.vertex.xyz",
        "APP_NAME": "Vertex Research",
        "DATABASE_PROVIDER": "postgres",
        "BETTER_AUTH_URL": "https://staging.vertex.xyz",
        "EMAIL_PROVIDER": "disabled",
        "EMAIL_TRANSPORT": "disabled"
      }
      // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<staging-hyperdrive-id>" }]
    }
  }
}
