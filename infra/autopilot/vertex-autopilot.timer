# Runs the Autopilot tick every minute on the :00 boundary so it shares the minute tick with
# vertex-flow.timer and leaves a >35 s quiet window for infra/quantvps/restart-when-idle.sh.
# Each running campaign works for its tick slice (default 20 s); Type=oneshot skips overlapping runs.
[Unit]
Description=Vertex Autopilot tick timer (research only)

[Timer]
OnCalendar=*-*-* *:*:00
AccuracySec=1s
Persistent=false

[Install]
WantedBy=timers.target
