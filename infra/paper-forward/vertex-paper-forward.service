# Vertex paper forward tick (paper only: simulated fills, no broker calls).
# Install as a user unit: copy this file and the .timer to ~/.config/systemd/user/, create the
# environment file below (mode 0600) and run: systemctl --user enable --now vertex-paper-forward.timer
# Environment file keys: VERTEX_ORIGIN (portal origin) and VERTEX_AGENT_API_KEY (operator write key).
[Unit]
Description=Vertex paper forward tick (paper only)
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/vertex/paper-forward.env
WorkingDirectory=%h/Github/trading/vertex-research-platform
ExecStart=/usr/bin/env bun run vertex:paper:tick
TimeoutStartSec=300
NoNewPrivileges=yes
