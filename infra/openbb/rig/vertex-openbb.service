# Vertex OpenBB ingest (card vertex-openbb; research only: public data, no orders). Rig user unit.
# Runs every job of vertex-openbb.steps through tick-runner (one timer for all jobs, owner card
# infra-bot-consolidation). Install with install.sh in this folder; see docs/vertex-rebuild/openbb.md.
[Unit]
Description=Vertex OpenBB ingest (research only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/Github/tools/self-healing-harness/bin/tick-runner vertex-openbb %h/.local/share/vertex-openbb/vertex-openbb.steps
# Steps of one stage run in parallel, stages one after another: stage 1 (Cboe, CFTC, Fed) max 420 s,
# stage 2 (Treasury, OECD, FRED, FINRA, Fama-French) max 330 s, SEC stages 3-6 350 + 350 + 350 + 600 s,
# plus 10 s per stage = 2460 s; install.test.ts checks the bound.
TimeoutStartSec=2520
# Marks a timer run for the wrapper (SEC lock: wait 20 s, then skip). INVOCATION_ID is no marker:
# desktop session shells on the rig set it too.
Environment=VERTEX_OPENBB_TIMER=1
# Memory pressure slows the steps first; at the hard cap the kernel kills one step, not the unit.
MemoryHigh=2560M
MemoryMax=3G
OOMPolicy=continue
Nice=10
NoNewPrivileges=yes
