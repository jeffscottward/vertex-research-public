# vertex-web-tailnet: Vertex Research web app ONLY on the VPS tailnet address.
# 2026-10-18: first version (app origin http://vertex.localhost, Host/Origin rewrite).
# 2026-10-21 (audit P0-1): the app is a production build (`vite preview`, infra/quantvps/run-preview.mjs)
# whose APP_URL/BETTER_AUTH_URL is this tailnet origin, so nothing is rewritten any more. This proxy:
#  - serves https://quant-vps-host.example-tailnet.ts.net:3451 with the Tailscale certificate,
#  - rejects any request whose Origin header is present and is not exactly that URL (defence in
#    depth; the app checks Origin against APP_URL too),
#  - passes Host and Origin unchanged and sets X-Forwarded-Proto: https (Caddy overwrites any
#    client value), so the Worker's request URL origin equals APP_URL,
#  - adds basic security headers (audit P1-7). Vertex uses no frames, so framing is denied.
{
  admin unix//tmp/caddy-admin.sock
  auto_https disable_redirects
  default_bind 100.64.0.10
}
https://quant-vps-host.example-tailnet.ts.net:3451 {
  bind 100.64.0.10
  tls {
    get_certificate tailscale
  }
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Content-Security-Policy "frame-ancestors 'none'"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
  @foreign_origin {
    header Origin *
    not header Origin https://quant-vps-host.example-tailnet.ts.net:3451
  }
  handle @foreign_origin {
    respond "forbidden origin" 403
  }
  # `vite preview` serves a Workers devtools launcher at /__debug; never expose it.
  handle /__debug* {
    respond 404
  }
  handle {
    reverse_proxy 127.0.0.1:3450 {
      header_up -X-Forwarded-Host
    }
  }
}
