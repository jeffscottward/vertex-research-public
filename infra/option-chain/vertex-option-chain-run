#!/usr/bin/env bash
# Runs one option-chain snapshot (research only: public Yahoo quotes into local files; no orders, no
# account, no secret) from the runner checkout. uv (the mise shim) provides Python 3.12 and the pinned
# yfinance; --exclude-newer keeps its dependencies at the versions of the day the pin was tested.
set -euo pipefail
cd "${OPTION_CHAIN_RUNNER_DIR:-$HOME/Github/trading/vertex-research-public-ticks-runner}"
UV="${OPTION_CHAIN_UV:-$HOME/.local/share/mise/shims/uv}"
if [[ ! -x "$UV" ]]; then
  echo "vertex-option-chain-run: uv is not installed ($UV); run mise use -g uv" >&2
  exit 127
fi
export PATH="/usr/local/bin:/usr/bin:/bin"
exec "$UV" run --no-project --python 3.12 --with yfinance==0.2.66 --exclude-newer 2026-11-11T00:00:00Z \
  python research/backtests/option-chain/snapshot.py \
  --store "${OPTION_CHAIN_STORE:-$HOME/.local/share/vertex/option-chain}" "$@"
