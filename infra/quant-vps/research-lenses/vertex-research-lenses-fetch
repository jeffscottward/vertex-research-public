#!/usr/bin/env bash
# ExecStartPre of vertex-rotation-matrix.service and vertex-deep-value.service on the rig.
# Exports scripts/research-lenses from vertex-research-public into the runner directory, so the
# data jobs never run from a working checkout. LENSES_BRANCH (research-lenses.env) overrides the branch.
# Research only: Nasdaq/Yahoo/SEC public data, no IBKR, places nothing.
set -euo pipefail
REPO="${LENSES_REPO:-$HOME/Github/trading/vertex-research-public}"
BRANCH="${LENSES_BRANCH:-vertex/rebuild-darkfactory-20260921}"
APP="$HOME/.local/share/vertex-research-lenses/app"
git -C "$REPO" fetch -q origin "$BRANCH" || echo "fetch of $BRANCH failed; using the last fetched copy" >&2
git -C "$REPO" cat-file -e "origin/$BRANCH:scripts/research-lenses/collect-rotation-matrix.ts"
rm -rf "$APP.new" && mkdir -p "$APP.new"
git -C "$REPO" archive "origin/$BRANCH" scripts/research-lenses | tar -x -C "$APP.new"
rm -rf "$APP" && mv "$APP.new" "$APP"
echo "research lenses from origin/$BRANCH $(git -C "$REPO" rev-parse --short "origin/$BRANCH")" >&2
