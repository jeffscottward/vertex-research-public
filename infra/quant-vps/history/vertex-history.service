[Unit]
Description=Vertex read-only IBKR historical bars (IB client id 77, 127.0.0.1:8791)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
RuntimeDirectory=vertex-history
CacheDirectory=vertex-history
ExecStartPre=+/opt/vertex-history/resolve-gateway.sh
ExecStart=/opt/vertex-history/venv/bin/python -I -W ignore /opt/vertex-history/vertex_history.py
EnvironmentFile=/opt/vertex-status/token.env
# /option-chain (IB market data snapshots on the gateway the live engine shares) stays off unless the owner adds
# Environment=VERTEX_HISTORY_OPTION_QUOTES=1 (drop-in) and restarts the service.
DynamicUser=yes
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8 172.16.0.0/12
MemoryMax=256M
CPUQuota=50%
Nice=5

[Install]
WantedBy=multi-user.target
