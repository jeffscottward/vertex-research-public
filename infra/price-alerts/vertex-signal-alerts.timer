# Runs the signal alert and watch tick every 5 minutes on weekdays during US market hours (with
# margins). A tick evaluates at most 100 active rules over at most 20 symbol/timeframe series.
[Unit]
Description=Vertex signal alert and watch tick timer (research only)

[Timer]
OnCalendar=Mon..Fri *-*-* 13..21:00/5:00 UTC
RandomizedDelaySec=30
Persistent=false

[Install]
WantedBy=timers.target
