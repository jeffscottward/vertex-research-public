# Vertex signal alert and watch tick (research only: public bars, arithmetic evaluation with no model
# call, fixed-text ntfy notifications, no orders). Not installed or enabled by default. To install as a
# user unit: copy this file and the .timer to ~/.config/systemd/user/, reuse the price alert
# environment file below (mode 0600) and run:
# systemctl --user enable --now vertex-signal-alerts.timer
# Environment file keys: VERTEX_ORIGIN (portal origin) and VERTEX_AGENT_API_KEY (operator write key).
[Unit]
Description=Vertex signal alert and watch tick (research only)
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/vertex/price-alerts.env
WorkingDirectory=%h/Github/trading/vertex-research-platform
ExecStart=/usr/bin/env bun run vertex:signal-alerts:tick
TimeoutStartSec=300
NoNewPrivileges=yes
