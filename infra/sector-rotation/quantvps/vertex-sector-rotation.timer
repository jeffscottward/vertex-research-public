# Runs the sector rotation collection twice on weekdays after the US close (New York time): 16:50, and
# 18:40 as a retry for late or corrected bars. Alerts are insert-once, so the second run never
# repeats an alert. Persistent=true runs a missed collection after the machine wakes; a run during
# the session ignores the live (unfinished) daily bar.
[Unit]
Description=Vertex sector rotation collection timer (research only)

[Timer]
OnCalendar=Mon..Fri *-*-* 16:50:00 America/New_York
OnCalendar=Mon..Fri *-*-* 18:40:00 America/New_York
RandomizedDelaySec=60
Persistent=true

[Install]
WantedBy=timers.target
