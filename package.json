{
  "name": "@darkfactory/root",
  "version": "0.3.1",
  "private": true,
  "description": "Vertex Research, a research-first trading platform built on DarkFactory.",
  "homepage": "https://github.com/jeffscottward/darkfactory#readme",
  "bugs": {
    "url": "https://github.com/jeffscottward/darkfactory/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffscottward/darkfactory.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "academy:lessons": "bun scripts/academy/build-lesson-index.ts",
    "academy:lessons:check": "bun scripts/academy/build-lesson-index.ts --check",
    "academy:sources": "bun scripts/academy/build-sources.ts",
    "agent-desk": "bun scripts/agent-desk.ts",
    "auth:schema:check": "pnpm --filter @darkfactory/auth exec bun run auth:schema:check",
    "build": "bunx --no-install turbo run build",
    "certs:generate": "mkdir -p .certs && mkcert -cert-file .certs/localhost.pem -key-file .certs/localhost-key.pem localhost '*.localhost' 127.0.0.1 ::1",
    "certs:install": "mkcert -install",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "db:check": "pnpm --filter @darkfactory/db exec bun run db:check",
    "db:generate": "pnpm --filter @darkfactory/db exec bun run db:generate",
    "db:migrate": "pnpm --filter @darkfactory/db exec -- bun --env-file=../../.env run db:migrate",
    "db:renumber": "bun --no-env-file scripts/db-renumber.ts",
    "db:reset": "bun scripts/database/index.ts reset",
    "db:seed": "bun scripts/database/index.ts seed",
    "db:test:down": "docker compose --project-name vertex-research-platform --env-file /dev/null -f infra/docker/postgres.compose.yml down --volumes --remove-orphans",
    "db:test:up": "docker compose --project-name vertex-research-platform --env-file /dev/null -f infra/docker/postgres.compose.yml up --detach --wait",
    "deploy:web": "bun scripts/deployment.ts --environment production --mode deploy --destination-receipt private/deployment/production.json",
    "deploy:web:check": "bun scripts/deployment.ts --environment production --mode check --destination-receipt private/deployment/production.json",
    "deploy:web:offline-inputs": "bun --no-env-file scripts/deployment-inputs.ts fingerprint",
    "deploy:web:preview": "bun scripts/deployment.ts --environment preview",
    "deploy:web:staging": "bun scripts/deployment.ts --environment staging --mode deploy --destination-receipt private/deployment/staging.json",
    "deploy:web:staging:check": "bun scripts/deployment.ts --environment staging --mode check --destination-receipt private/deployment/staging.json",
    "deploy:web:staging:validate": "bun scripts/deployment.ts --environment staging --destination-receipt private/deployment/staging.json",
    "deploy:web:validate": "bun scripts/deployment.ts --environment production --destination-receipt private/deployment/production.json",
    "dev": "bun scripts/dev-bindings.ts && portless darkfactory bun scripts/dev.ts web",
    "dev:bindings": "bun scripts/dev-bindings.ts",
    "dev:trust": "portless trust",
    "docs:check": "bun scripts/docs.ts check",
    "docs:generate": "bun scripts/docs.ts generate",
    "doctor": "bun scripts/doctor.ts",
    "eval:semantic:record": "bun scripts/with-test-env.ts bun tests/integration/semantic-layer/record.ts",
    "format": "bunx --bun --no-install biome format --write .",
    "format:check": "bunx --bun --no-install biome format .",
    "format:staged": "bunx --bun --no-install biome format --no-errors-on-unmatched",
    "generate:feature": "bun scripts/generate-feature.ts",
    "graph:build": "bun scripts/graph.ts build",
    "graph:check": "bun scripts/graph.ts check",
    "graph:update": "bun scripts/graph.ts update",
    "graph:verify": "bun scripts/graph.ts verify",
    "init": "bun scripts/init.ts",
    "lint": "bunx --bun --no-install biome lint . && bun run lint:markdown && bun run lint:knip",
    "lint:knip": "bunx --no-install knip",
    "lint:markdown": "git ls-files -z -- '*.md' | xargs -0 bunx --bun --no-install markdownlint-cli2",
    "lint:markdown:staged": "bunx --bun --no-install markdownlint-cli2",
    "lint:staged": "bunx --bun --no-install biome lint --no-errors-on-unmatched",
    "openapi:check": "pnpm --filter @darkfactory/api exec bun run openapi:check",
    "openapi:generate": "pnpm --filter @darkfactory/api exec bun run openapi:generate",
    "operator:bindings": "bun scripts/dev-bindings.ts operator",
    "operator:dev": "bun scripts/dev-bindings.ts operator && portless operator.darkfactory bun scripts/dev.ts operator",
    "prepare": "bunx --bun --no-install husky",
    "research:academy-golden": "bun scripts/research-academy-golden.ts",
    "research:backtest-151": "bun scripts/research-backtest-151.ts",
    "research:calendar-spread": "bun --no-env-file scripts/research-calendar-spread.ts",
    "research:core7": "bun scripts/vertex-core7-rerun.ts",
    "research:nautilus-golden": "bun scripts/research-nautilus-golden.ts",
    "research:nautilus-parity": "bun scripts/research-nautilus-parity.ts",
    "research:qc-port-definitions": "bun --no-env-file scripts/research-qc-port-definitions.ts",
    "research:quantjourney": "bun scripts/research-quantjourney.ts",
    "research:sector-rotation:freeze": "bun --no-env-file scripts/sector-rotation-backtest-freeze.ts",
    "setup": "bun scripts/setup.ts",
    "test": "bun run test:unit && bun run test:contract && bun run test:operations && bun run test:acceptance && bun run test:integration && bun run verify:browser",
    "test:a11y": "bun scripts/with-test-env.ts pnpm exec playwright test --project a11y",
    "test:acceptance": "pnpm exec vitest run --config vitest.config.ts --project acceptance",
    "test:contract": "pnpm exec vitest run --config vitest.config.ts --project contract",
    "test:e2e": "bun scripts/with-test-env.ts pnpm exec playwright test --project e2e",
    "test:gateway": "bun scripts/gateway-test.ts",
    "test:integration": "bun scripts/with-test-env.ts pnpm exec vitest run --config vitest.config.ts --project integration",
    "test:json-data": "pnpm exec vitest run --config vitest.config.ts --project operations scripts/ci/json-data.test.ts",
    "test:operations": "pnpm exec vitest run --config vitest.config.ts --project operations --project e2e-helpers",
    "test:unit": "bunx --no-install turbo run test:unit --concurrency=50% --filter=!@darkfactory/api -- --maxWorkers=1 && bunx --no-install turbo run test:unit --filter=@darkfactory/api -- --maxWorkers=100% && bun run test:unit:root",
    "test:unit:root": "pnpm exec vitest run --config vitest.config.ts --project unit tests/generator playwright.config.test.ts infra",
    "typecheck": "bunx --no-install turbo run typecheck && tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p infra/tsconfig.json",
    "verify": "bun run verify:core && bun run verify:coverage && bun run verify:integration && bun run verify:browser",
    "verify:browser": "bun run build && bun scripts/with-test-env.ts pnpm exec playwright test",
    "verify:core": "bun run format:check && bun run lint && bun run auth:schema:check && bun run openapi:check && bun run typecheck && bun run docs:check && bun run test:gateway",
    "verify:coverage": "bun scripts/coverage-lane.ts pnpm exec vitest run --config vitest.config.ts --project unit --project contract --project operations --project e2e-helpers --project acceptance --coverage",
    "verify:integration": "bun run test:integration",
    "verify:prepush": "bun run verify:core && bun run test:unit && bun run test:contract && bun run test:operations",
    "vertex:academy:import": "bun --no-env-file scripts/vertex-academy-import.ts",
    "vertex:alerts:tick": "bun --no-env-file scripts/vertex-price-alerts-tick.ts",
    "vertex:autopilot:tick": "bun --no-env-file scripts/vertex-autopilot-tick.ts",
    "vertex:backtest-worker:nautilus": "bun --no-env-file scripts/vertex-backtest-worker-nautilus.ts",
    "vertex:bars:import": "bun --no-env-file scripts/vertex-market-bars-import.ts",
    "vertex:baskets:seed": "bun --no-env-file scripts/vertex-baskets-seed.ts",
    "vertex:breadth-90:tick": "bun --no-env-file scripts/vertex-breadth-90-tick.ts",
    "vertex:clicks": "bun --no-env-file scripts/vertex-click-log.ts",
    "vertex:config": "bun --no-env-file scripts/vertex-config.ts",
    "vertex:contracts:fixtures": "bun --no-env-file scripts/vertex-contracts.ts fixtures",
    "vertex:contracts:generate": "bun --no-env-file scripts/vertex-contracts.ts generate",
    "vertex:contracts:proof-fixtures": "bun --no-env-file scripts/vertex-contracts.ts proof-fixtures",
    "vertex:engine-comparison-report": "bun --no-env-file scripts/vertex-engine-comparison-report.ts",
    "vertex:flow:tick": "bun --no-env-file scripts/vertex-flow-tick.ts",
    "vertex:golden-battery": "bun --no-env-file scripts/vertex-golden-battery.ts",
    "vertex:instant-backtest:bench": "bun --no-env-file scripts/vertex-instant-backtest-bench.ts",
    "vertex:janitor": "bun --no-env-file scripts/vertex-janitor.ts",
    "vertex:openbb:tick": "bun --no-env-file scripts/vertex-openbb-tick.ts",
    "vertex:owner-caps:check": "bun --no-env-file scripts/vertex-owner-caps-check.ts",
    "vertex:paper:tick": "bun --no-env-file scripts/vertex-paper-forward-tick.ts",
    "vertex:pick-lists": "bun --no-env-file scripts/vertex-pick-lists.ts",
    "vertex:plays:upsert": "bun --no-env-file scripts/vertex-plays-upsert.ts",
    "vertex:quantlab:record": "bun --no-env-file scripts/vertex-quant-lab-record.ts",
    "vertex:research-reports:import": "bun --no-env-file scripts/vertex-research-reports-import.ts",
    "vertex:research-studies:import": "bun --no-env-file scripts/vertex-research-studies-import.ts",
    "vertex:sector-rotation:tick": "bun --no-env-file scripts/vertex-sector-rotation-tick.ts",
    "vertex:series:import": "bun --no-env-file scripts/vertex-market-series-import.ts",
    "vertex:signal-alerts:tick": "bun --no-env-file scripts/vertex-signal-alerts-tick.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@biomejs/biome": "catalog:",
    "@darkfactory/api": "workspace:*",
    "@darkfactory/auth": "workspace:*",
    "@darkfactory/config": "workspace:*",
    "@darkfactory/db": "workspace:*",
    "@darkfactory/email": "workspace:*",
    "@darkfactory/jobs": "workspace:*",
    "@darkfactory/observability": "workspace:*",
    "@darkfactory/operator": "workspace:*",
    "@darkfactory/state": "workspace:*",
    "@darkfactory/testkit": "workspace:*",
    "@darkfactory/ui": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "catalog:",
    "jsdom": "^30.1.3",
    "jsonc-parser": "catalog:",
    "knip": "catalog:",
    "markdownlint-cli2": "catalog:",
    "pg": "catalog:",
    "portless": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-api": "catalog:",
    "ultracite": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "bun": "1.4.2",
    "node": ">=24.21.0",
    "pnpm": "11.16.0"
  },
  "brick": "workspace"
}
